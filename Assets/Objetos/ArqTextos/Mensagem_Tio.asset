  m_Name: Mensagem_Tio
  m_EditorClassIdentifier: 
  itemName: Para_Pedro.txt
  icon: {fileID: 21300000, guid: ed7ca550cdf65804db1ec1cddffb3892, type: 3}
  textContent: "Pedro,\n\nEscuta bem e n\xE3o perca tempo lendo isso duas vezes.
    Eu tive que sair \xE0s pressas e n\xE3o sei se vou conseguir te avisar de novo,
    ou se a gente vai se ver outra vez.\n\nAs decis\xF5es que eu fiz atra\xEDram
    a aten\xE7\xE3o de pessoas muito perigosas que est\xE3o atr\xE1s de mim \u2014
    e, muito provavelmente, neste momento, atr\xE1s de voc\xEA. N\xE3o acredite em
    ningu\xE9m e tome cuidado.\n\nSe cuida, garoto..."
  editable: 0
